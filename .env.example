# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.ngrok-free.app/webhook
TELEGRAM_SECRET_TOKEN=optional_webhook_secret_token

# Google Gemini API & Agent SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database Connection (PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql+asyncpg://tracker:password@localhost:5432/nutrition_tracker
# Fallback local sqlite for quick testing:
# DATABASE_URL=sqlite+aiosqlite:///./data/nutrition_tracker.db

# Observability (OpenTelemetry & Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ENABLE_OTEL_TRACING=true

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
